API_PORT=5060

# TypeSafe Jev (console.typesafe.ai). Server only; never sent to the browser.
# Without it, search still works but X-ray and fit scoring are off.
TYPESAFE_API_KEY=your_typesafe_api_key

# Apify (console.apify.com > Settings > Integrations). Without it, live
# searches are off.
APIFY_TOKEN=your_apify_token

# MongoDB connection string WITHOUT the database name; MONGODB_DB is appended.
# Leave empty to run in guest mode (in-memory searches, no accounts).
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/
MONGODB_DB=triage_jobs

JWT_SECRET=a_long_random_string
JWT_EXPIRES_IN=7d

# Optional tuning
# MAX_RESULTS_PER_SOURCE=50
# APIFY_MAX_CHARGE_PER_RUN_USD=0.25
# SEARCH_CACHE_HOURS=6
# GUEST_SEARCHES_PER_HOUR=6
# USER_SEARCHES_PER_DAY=40
# JEV_CONCURRENCY=8
# APIFY_LINKEDIN_ACTOR=valig/linkedin-jobs-scraper
# APIFY_INDEED_ACTOR=valig/indeed-jobs-scraper
# APIFY_GLASSDOOR_ACTOR=valig/glassdoor-jobs-scraper
# TRUST_PROXY=1
